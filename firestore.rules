rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isNipEmployeeAccount() {
      return isSignedIn()
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[0-9]{8,20}@pegawai\\.kemenagmura\\.id$');
    }

    function isVerifiedUser() {
      return isSignedIn() && (
        ('email_verified' in request.auth.token && request.auth.token.email_verified == true)
        || isNipEmployeeAccount()
      );
    }

    function isAdmin() {
      return isSignedIn()
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true
        && 'email' in request.auth.token
        && request.auth.token.email == 'kemenagmuraptsp@gmail.com';
    }

    function hasActiveVerifiedEmployee(empData) {
      return empData is map
        && 'status' in empData
        && empData.status == 'active';
    }

    function isVerifiedEmployee() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/verifiedEmployees/$(request.auth.uid))
        && hasActiveVerifiedEmployee(
          get(/databases/$(database)/documents/verifiedEmployees/$(request.auth.uid)).data
        );
    }

    function isKuaEmployeeData(empData) {
      return hasActiveVerifiedEmployee(empData)
        && 'unitCategory' in empData
        && empData.unitCategory == 'kua_kecamatan';
    }

    function isVerifiedKuaEmployee() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/verifiedEmployees/$(request.auth.uid))
        && isKuaEmployeeData(
          get(/databases/$(database)/documents/verifiedEmployees/$(request.auth.uid)).data
        );
    }

    function isValidUnitCategory(val) {
      return val is string && (val == 'kankemenag' || val == 'kua_kecamatan' || val == 'madrasah');
    }

    function isValidOperatorRole(val) {
      return val is string && (
        val == 'pegawai' ||
        val == 'operator_ptsp' ||
        val == 'operator_seksi' ||
        val == 'pimpinan'
      );
    }

    function isValidAssignedUnitId(val) {
      return val is string && (
        val == 'all' ||
        val == 'sekretariat' ||
        val == 'bimas-islam' ||
        val == 'pendis' ||
        val == 'bimas-hindu' ||
        val == 'bimas-kristen' ||
        val == 'kepegawaian'
      );
    }

    function isValidSeksiUnitId(val) {
      return val is string && (
        val == 'sekretariat' ||
        val == 'bimas-islam' ||
        val == 'pendis' ||
        val == 'bimas-hindu' ||
        val == 'bimas-kristen' ||
        val == 'kepegawaian'
      );
    }

    function isValidTicketStatus(val) {
      return val is string && (
        val == 'Diproses Verifikasi' ||
        val == 'Diterima PTSP' ||
        val == 'Ditolak PTSP' ||
        val == 'Disposisi ke Seksi' ||
        val == 'Telaah Seksi' ||
        val == 'Perlu Revisi' ||
        val == 'Siap TTE' ||
        val == 'TTE Sah (Selesai)' ||
        val == 'Menunggu Berkas' ||
        val == 'Selesai'
      );
    }

    function isPtspOperatorAllowedStatus(status) {
      return status == 'Diproses Verifikasi'
        || status == 'Diterima PTSP'
        || status == 'Ditolak PTSP'
        || status == 'Disposisi ke Seksi'
        || status == 'Perlu Revisi'
        || status == 'Menunggu Berkas';
    }

    function isSeksiOperatorAllowedStatus(status) {
      return status == 'Disposisi ke Seksi'
        || status == 'Telaah Seksi'
        || status == 'Perlu Revisi'
        || status == 'Menunggu Berkas'
        || status == 'Siap TTE';
    }

    function isPimpinanAllowedStatus(status) {
      return status == 'Siap TTE'
        || status == 'Perlu Revisi'
        || status == 'TTE Sah (Selesai)';
    }

    function isOperatorPtspData(empData) {
      return hasActiveVerifiedEmployee(empData)
        && 'operatorRole' in empData
        && empData.operatorRole == 'operator_ptsp';
    }

    function isOperatorPtsp() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/verifiedEmployees/$(request.auth.uid))
        && isOperatorPtspData(
          get(/databases/$(database)/documents/verifiedEmployees/$(request.auth.uid)).data
        );
    }

    function isPimpinanData(empData) {
      return hasActiveVerifiedEmployee(empData)
        && 'operatorRole' in empData
        && empData.operatorRole == 'pimpinan';
    }

    function isPimpinan() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/verifiedEmployees/$(request.auth.uid))
        && isPimpinanData(
          get(/databases/$(database)/documents/verifiedEmployees/$(request.auth.uid)).data
        );
    }

    function isOperatorSeksiDataForUnit(empData, unitId) {
      return hasActiveVerifiedEmployee(empData)
        && 'operatorRole' in empData
        && empData.operatorRole == 'operator_seksi'
        && 'assignedUnitId' in empData
        && empData.assignedUnitId == unitId;
    }

    function isOperatorSeksiForUnit(unitId) {
      return isSignedIn()
        && unitId is string
        && exists(/databases/$(database)/documents/verifiedEmployees/$(request.auth.uid))
        && isOperatorSeksiDataForUnit(
          get(/databases/$(database)/documents/verifiedEmployees/$(request.auth.uid)).data,
          unitId
        );
    }

    function isOperatorSeksiDispatchedTicket(data) {
      return ('dispatchedToSeksi' in data && data.dispatchedToSeksi == true)
        && ('dispatchedUnitId' in data
          && data.dispatchedUnitId is string
          && isOperatorSeksiForUnit(data.dispatchedUnitId));
    }

    function canReadTicket(data) {
      return isAdmin() || isOperatorPtsp() || isPimpinan() || isOperatorSeksiDispatchedTicket(data);
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'lastLoginAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && data.createdAt is timestamp
        && data.lastLoginAt is timestamp;
    }

    function isValidDownloadLog(data) {
      return data.keys().hasAll([
          'userId',
          'userName',
          'userEmail',
          'documentId',
          'documentTitle',
          'category',
          'year',
          'downloadedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'userName',
          'userEmail',
          'documentId',
          'documentTitle',
          'category',
          'year',
          'downloadedAt'
        ])
        && data.userId is string && isValidId(data.userId)
        && data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 120
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160
        && data.documentId is string && data.documentId.size() >= 1 && data.documentId.size() <= 80 && data.documentId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.documentTitle is string && data.documentTitle.size() >= 1 && data.documentTitle.size() <= 200
        && data.category is string && (data.category == 'zakat' || data.category == 'imsakiyah')
        && data.year is int && data.year >= 2020 && data.year <= 2035
        && data.downloadedAt is timestamp;
    }

    function isValidEmployeeRequest(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'nip',
          'jabatan',
          'unitKerja',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'nip',
          'jabatan',
          'unitKerja',
          'unitCategory',
          'status',
          'adminNote',
          'reviewedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.nip is string && data.nip.size() >= 8 && data.nip.size() <= 30 && data.nip.matches('^[0-9A-Za-z\\-\\s]+$')
        && data.jabatan is string && data.jabatan.size() >= 2 && data.jabatan.size() <= 120
        && data.unitKerja is string && data.unitKerja.size() >= 2 && data.unitKerja.size() <= 150
        && (!('unitCategory' in data) || isValidUnitCategory(data.unitCategory))
        && data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300))
        && (!('reviewedBy' in data) || (data.reviewedBy is string && data.reviewedBy.size() <= 160))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVerifiedEmployee(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'fullName',
          'nip',
          'jabatan',
          'unitKerja',
          'status',
          'verifiedBy',
          'verifiedAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'fullName',
          'nip',
          'jabatan',
          'unitKerja',
          'unitCategory',
          'operatorRole',
          'assignedUnitId',
          'assignedUnitTitle',
          'status',
          'verifiedBy',
          'verifiedAt',
          'updatedAt'
        ])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120
        && data.nip is string && data.nip.size() >= 8 && data.nip.size() <= 30 && data.nip.matches('^[0-9A-Za-z\\-\\s]+$')
        && data.jabatan is string && data.jabatan.size() >= 2 && data.jabatan.size() <= 120
        && data.unitKerja is string && data.unitKerja.size() >= 2 && data.unitKerja.size() <= 150
        && (!('unitCategory' in data) || isValidUnitCategory(data.unitCategory))
        && (!('operatorRole' in data) || isValidOperatorRole(data.operatorRole))
        && (!('assignedUnitId' in data) || isValidAssignedUnitId(data.assignedUnitId))
        && (!('assignedUnitTitle' in data) || (data.assignedUnitTitle is string && data.assignedUnitTitle.size() <= 100))
        && data.status is string && (data.status == 'active' || data.status == 'revoked')
        && data.verifiedBy is string && data.verifiedBy.size() >= 3 && data.verifiedBy.size() <= 160
        && data.verifiedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNewsArticle(data, articleId) {
      return data.keys().hasAll([
          'id',
          'slug',
          'title',
          'category',
          'section',
          'date',
          'readTime',
          'views',
          'image',
          'excerpt',
          'content',
          'reactions',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'slug',
          'title',
          'category',
          'section',
          'date',
          'readTime',
          'views',
          'image',
          'excerpt',
          'content',
          'reactions',
          'isDeleted',
          'createdBy',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id == articleId && isValidId(data.id)
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 200
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 220
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 80
        && data.section is string && (
          data.section == 'hari-ini' ||
          data.section == 'kegiatan' ||
          data.section == 'nasional' ||
          data.section == 'terpopuler'
        )
        && data.date is string && data.date.size() >= 3 && data.date.size() <= 60
        && data.readTime is string && data.readTime.size() >= 2 && data.readTime.size() <= 40
        && data.views is int && data.views >= 0 && data.views <= 10000000
        && data.image is string && data.image.size() >= 1 && data.image.size() <= 500
        && data.excerpt is string && data.excerpt.size() >= 5 && data.excerpt.size() <= 600
        && data.content is list && data.content.size() >= 1 && data.content.size() <= 40
        && data.reactions is map
        && data.reactions.keys().hasAll(['bermanfaat', 'informatif', 'inspiratif'])
        && data.reactions.keys().hasOnly(['bermanfaat', 'informatif', 'inspiratif'])
        && data.reactions.bermanfaat is int && data.reactions.bermanfaat >= 0
        && data.reactions.informatif is int && data.reactions.informatif >= 0
        && data.reactions.inspiratif is int && data.reactions.inspiratif >= 0
        && (!('isDeleted' in data) || data.isDeleted is bool)
        && data.createdBy is string && data.createdBy.size() >= 3 && data.createdBy.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPtspTicket(data, ticketId) {
      return data.keys().hasAll([
          'id',
          'ticketNo',
          'userId',
          'userEmail',
          'accountTier',
          'unitId',
          'unitTitle',
          'subServiceId',
          'serviceTitle',
          'applicantName',
          'phone',
          'status',
          'submittedAtLabel',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ticketNo',
          'userId',
          'userEmail',
          'accountTier',
          'unitId',
          'unitTitle',
          'subServiceId',
          'serviceTitle',
          'applicantName',
          'phone',
          'institution',
          'nip',
          'notes',
          'status',
          'adminNote',
          'dispatchedToSeksi',
          'dispatchedUnitId',
          'dispatchedUnitTitle',
          'dispatchedBy',
          'seksiReviewer',
          'tteSentToLeader',
          'tteLeaderNote',
          'checkedDocsPattern',
          'verifiedDocsCount',
          'totalDocsCount',
          'uploadedDocsCount',
          'tteDocNumber',
          'tteSignerName',
          'tteSignerTitle',
          'tteSignerNip',
          'tteSignedAtLabel',
          'submittedAtLabel',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id == ticketId && isValidId(data.id)
        && data.ticketNo is string && data.ticketNo.size() >= 6 && data.ticketNo.size() <= 40 && data.ticketNo.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && isValidId(data.userId)
        && data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 160
        && data.accountTier is string && (data.accountTier == 'masyarakat' || data.accountTier == 'pegawai' || data.accountTier == 'admin')
        && data.unitId is string && data.unitId.size() >= 1 && data.unitId.size() <= 40 && data.unitId.matches('^[a-z0-9\\-]+$')
        && data.unitTitle is string && data.unitTitle.size() >= 2 && data.unitTitle.size() <= 100
        && data.subServiceId is string && data.subServiceId.size() >= 1 && data.subServiceId.size() <= 60 && data.subServiceId.matches('^[a-z0-9\\-]+$')
        && data.serviceTitle is string && data.serviceTitle.size() >= 2 && data.serviceTitle.size() <= 200
        && data.applicantName is string && data.applicantName.size() >= 2 && data.applicantName.size() <= 120
        && data.phone is string && data.phone.size() >= 6 && data.phone.size() <= 30
        && (!('institution' in data) || (data.institution is string && data.institution.size() <= 160))
        && (!('nip' in data) || (data.nip is string && data.nip.size() <= 30))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && isValidTicketStatus(data.status)
        && (!('adminNote' in data) || (data.adminNote is string && data.adminNote.size() <= 300))
        && (!('dispatchedToSeksi' in data) || data.dispatchedToSeksi is bool)
        && (!('dispatchedUnitId' in data) || isValidSeksiUnitId(data.dispatchedUnitId))
        && (!('dispatchedUnitTitle' in data) || (data.dispatchedUnitTitle is string && data.dispatchedUnitTitle.size() <= 100))
        && (!('dispatchedBy' in data) || (data.dispatchedBy is string && data.dispatchedBy.size() <= 160))
        && (!('seksiReviewer' in data) || (data.seksiReviewer is string && data.seksiReviewer.size() <= 160))
        && (!('tteSentToLeader' in data) || data.tteSentToLeader is bool)
        && (!('tteLeaderNote' in data) || (data.tteLeaderNote is string && data.tteLeaderNote.size() <= 300))
        && (!('checkedDocsPattern' in data) || (data.checkedDocsPattern is string && data.checkedDocsPattern.size() <= 40 && data.checkedDocsPattern.matches('^[01]{0,40}$')))
        && (!('verifiedDocsCount' in data) || (data.verifiedDocsCount is number && data.verifiedDocsCount >= 0 && data.verifiedDocsCount <= 40))
        && (!('totalDocsCount' in data) || (data.totalDocsCount is number && data.totalDocsCount >= 0 && data.totalDocsCount <= 40))
        && (!('uploadedDocsCount' in data) || (data.uploadedDocsCount is number && data.uploadedDocsCount >= 0 && data.uploadedDocsCount <= 40))
        && (!('tteDocNumber' in data) || (data.tteDocNumber is string && data.tteDocNumber.size() <= 100))
        && (!('tteSignerName' in data) || (data.tteSignerName is string && data.tteSignerName.size() <= 120))
        && (!('tteSignerTitle' in data) || (data.tteSignerTitle is string && data.tteSignerTitle.size() <= 120))
        && (!('tteSignerNip' in data) || (data.tteSignerNip is string && data.tteSignerNip.size() <= 30))
        && (!('tteSignedAtLabel' in data) || (data.tteSignedAtLabel is string && data.tteSignedAtLabel.size() <= 50))
        && data.submittedAtLabel is string && data.submittedAtLabel.size() >= 4 && data.submittedAtLabel.size() <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttachmentMime(val) {
      return val is string && (
        val == 'application/pdf' ||
        val == 'image/jpeg' ||
        val == 'image/png' ||
        val == 'image/webp'
      );
    }

    function isValidTicketAttachment(data, ticketId, attachmentId) {
      return data.keys().hasAll([
          'id',
          'ticketId',
          'userId',
          'requirementIndex',
          'requirementLabel',
          'fileName',
          'mimeType',
          'fileSize',
          'dataUrl',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ticketId',
          'userId',
          'requirementIndex',
          'requirementLabel',
          'fileName',
          'mimeType',
          'fileSize',
          'dataUrl',
          'createdAt'
        ])
        && data.id is string && data.id == attachmentId && isValidId(data.id)
        && data.ticketId is string && data.ticketId == ticketId && isValidId(data.ticketId)
        && data.userId is string && isValidId(data.userId)
        && data.requirementIndex is int && data.requirementIndex >= 0 && data.requirementIndex <= 40
        && data.requirementLabel is string && data.requirementLabel.size() >= 1 && data.requirementLabel.size() <= 300
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 180
        && isValidAttachmentMime(data.mimeType)
        && data.fileSize is int && data.fileSize >= 1 && data.fileSize <= 10485760
        && data.dataUrl is string
        && data.dataUrl.size() >= 20
        && data.dataUrl.size() <= 800000
        && data.dataUrl.matches('^data:(application/pdf|image/jpeg|image/png|image/webp);base64,[A-Za-z0-9+/=]+$')
        && data.createdAt is timestamp;
    }

    function isValidInfoSectionData(data, docId) {
      return data.keys().hasAll([
          'id',
          'seksiUnitId',
          'infoUnitId',
          'sectionId',
          'sectionLabel',
          'title',
          'updatedAtLabel',
          'columns',
          'rowsJson',
          'rowCount',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'seksiUnitId',
          'infoUnitId',
          'sectionId',
          'sectionLabel',
          'title',
          'subtitle',
          'updatedAtLabel',
          'columns',
          'rowsJson',
          'rowCount',
          'metricsJson',
          'orgNodesJson',
          'footnote',
          'updatedByName',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string && data.id == docId && isValidId(data.id)
        && isValidSeksiUnitId(data.seksiUnitId)
        && data.infoUnitId is string && data.infoUnitId.size() >= 1 && data.infoUnitId.size() <= 60 && data.infoUnitId.matches('^[a-z0-9\\-]+$')
        && data.sectionId is string && data.sectionId.size() >= 1 && data.sectionId.size() <= 80 && data.sectionId.matches('^[a-z0-9\\-]+$')
        && data.id == data.seksiUnitId + '__' + data.sectionId
        && data.sectionLabel is string && data.sectionLabel.size() >= 1 && data.sectionLabel.size() <= 100
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 200
        && (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 400))
        && data.updatedAtLabel is string && data.updatedAtLabel.size() >= 2 && data.updatedAtLabel.size() <= 80
        && data.columns is list && data.columns.size() >= 1 && data.columns.size() <= 20 && data.columns[0] is string
        && data.rowsJson is string && data.rowsJson.size() >= 2 && data.rowsJson.size() <= 400000
        && data.rowCount is int && data.rowCount >= 0 && data.rowCount <= 5000
        && (!('metricsJson' in data) || (data.metricsJson is string && data.metricsJson.size() <= 20000))
        && (!('orgNodesJson' in data) || (data.orgNodesJson is string && data.orgNodesJson.size() <= 60000))
        && (!('footnote' in data) || (data.footnote is string && data.footnote.size() <= 400))
        && data.updatedByName is string && data.updatedByName.size() >= 2 && data.updatedByName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isVerifiedUser()
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().lastLoginAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedUser()
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().lastLoginAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLoginAt']);

      allow delete: if false;
    }

    match /downloadLogs/{logId} {
      allow get: if isValidId(logId) && isVerifiedUser() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidDownloadLog(incoming())
        && incoming().userId == request.auth.uid
        && incoming().userEmail == request.auth.token.email
        && incoming().downloadedAt == request.time;

      allow update, delete: if false;
    }

    match /employeeRequests/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isVerifiedUser()
        && request.auth.uid == userId
        && isValidEmployeeRequest(incoming(), userId)
        && incoming().email == request.auth.token.email
        && incoming().status == 'pending'
        && !('adminNote' in incoming())
        && !('reviewedBy' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isVerifiedUser()
        && isValidEmployeeRequest(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().reviewedBy == request.auth.token.email
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'unitCategory', 'adminNote', 'reviewedBy', 'updatedAt'])
          )
          ||
          (
            request.auth.uid == userId
            && existing().status == 'rejected'
            && incoming().status == 'pending'
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'nip', 'jabatan', 'unitKerja', 'unitCategory', 'status', 'updatedAt'])
          )
        );

      allow delete: if isValidId(userId) && isAdmin();
    }

    match /verifiedEmployees/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isAdmin()
        && isValidVerifiedEmployee(incoming(), userId)
        && incoming().verifiedBy == request.auth.token.email
        && incoming().verifiedAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isAdmin()
        && isValidVerifiedEmployee(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().verifiedAt == existing().verifiedAt
        && incoming().updatedAt == request.time
        && incoming().verifiedBy == request.auth.token.email
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'fullName',
          'nip',
          'jabatan',
          'unitKerja',
          'unitCategory',
          'operatorRole',
          'assignedUnitId',
          'assignedUnitTitle',
          'status',
          'verifiedBy',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isAdmin();
    }

    match /ptspTickets/{ticketId} {
      allow get: if isValidId(ticketId) && isVerifiedUser() && (
        existing().userId == request.auth.uid || canReadTicket(existing())
      );
      allow list: if isVerifiedUser() && (
        resource.data.userId == request.auth.uid || canReadTicket(resource.data)
      );

      allow create: if isValidId(ticketId)
        && isVerifiedUser()
        && isValidPtspTicket(incoming(), ticketId)
        && incoming().userId == request.auth.uid
        && incoming().userEmail == request.auth.token.email
        && incoming().status == 'Diproses Verifikasi'
        && !('adminNote' in incoming())
        && !('dispatchedToSeksi' in incoming())
        && !('dispatchedUnitId' in incoming())
        && !('dispatchedUnitTitle' in incoming())
        && !('dispatchedBy' in incoming())
        && !('seksiReviewer' in incoming())
        && !('tteSentToLeader' in incoming())
        && !('tteLeaderNote' in incoming())
        && !('tteDocNumber' in incoming())
        && !('tteSignerName' in incoming())
        && !('tteSignerTitle' in incoming())
        && !('tteSignerNip' in incoming())
        && !('tteSignedAtLabel' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().unitId != 'kepegawaian' || isAdmin() || isVerifiedEmployee())
        && (incoming().subServiceId != 'bi-tauliyah-wali-hakim' || isAdmin() || isVerifiedKuaEmployee())
        && (
          incoming().accountTier == 'masyarakat'
          || (incoming().accountTier == 'pegawai' && (isVerifiedEmployee() || isAdmin()))
          || (incoming().accountTier == 'admin' && isAdmin())
        );

      allow update: if isValidId(ticketId)
        && isVerifiedUser()
        && isValidPtspTicket(incoming(), ticketId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'adminNote',
              'dispatchedToSeksi',
              'dispatchedUnitId',
              'dispatchedUnitTitle',
              'dispatchedBy',
              'seksiReviewer',
              'tteSentToLeader',
              'tteLeaderNote',
              'tteDocNumber',
              'tteSignerName',
              'tteSignerTitle',
              'tteSignerNip',
              'tteSignedAtLabel',
              'checkedDocsPattern',
              'verifiedDocsCount',
              'totalDocsCount',
              'updatedAt'
            ])
          )
          ||
          (
            isPtspOperatorAllowedStatus(incoming().status)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'adminNote',
              'dispatchedToSeksi',
              'dispatchedUnitId',
              'dispatchedUnitTitle',
              'dispatchedBy',
              'checkedDocsPattern',
              'verifiedDocsCount',
              'totalDocsCount',
              'updatedAt'
            ])
            && isOperatorPtsp()
          )
          ||
          (
            isSeksiOperatorAllowedStatus(incoming().status)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'adminNote',
              'seksiReviewer',
              'tteSentToLeader',
              'tteLeaderNote',
              'checkedDocsPattern',
              'verifiedDocsCount',
              'totalDocsCount',
              'updatedAt'
            ])
            && isOperatorSeksiDispatchedTicket(existing())
          )
          ||
          (
            isPimpinanAllowedStatus(incoming().status)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'adminNote',
              'tteLeaderNote',
              'tteDocNumber',
              'tteSignerName',
              'tteSignerTitle',
              'tteSignerNip',
              'tteSignedAtLabel',
              'updatedAt'
            ])
            && isPimpinan()
          )
        );

      allow delete: if false;

      match /attachments/{attachmentId} {
        allow get: if isValidId(ticketId)
          && isValidId(attachmentId)
          && isVerifiedUser()
          && (
            existing().userId == request.auth.uid
            || (
              exists(/databases/$(database)/documents/ptspTickets/$(ticketId))
              && canReadTicket(get(/databases/$(database)/documents/ptspTickets/$(ticketId)).data)
            )
          );

        allow list: if isVerifiedUser()
          && (
            resource.data.userId == request.auth.uid
            || isAdmin()
            || isOperatorPtsp()
            || isPimpinan()
            || (
              exists(/databases/$(database)/documents/ptspTickets/$(ticketId))
              && (
                get(/databases/$(database)/documents/ptspTickets/$(ticketId)).data.userId == request.auth.uid
                || canReadTicket(get(/databases/$(database)/documents/ptspTickets/$(ticketId)).data)
              )
            )
          );

        allow create: if isValidId(ticketId)
          && isValidId(attachmentId)
          && isVerifiedUser()
          && isValidTicketAttachment(incoming(), ticketId, attachmentId)
          && incoming().userId == request.auth.uid
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/ptspTickets/$(ticketId))
          && get(/databases/$(database)/documents/ptspTickets/$(ticketId)).data.userId == request.auth.uid;

        allow update, delete: if false;
      }
    }

    match /newsArticles/{articleId} {
      allow get, list: if true;

      allow create: if isValidId(articleId)
        && isAdmin()
        && isValidNewsArticle(incoming(), articleId)
        && incoming().createdBy == request.auth.token.email
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(articleId)
        && isAdmin()
        && isValidNewsArticle(incoming(), articleId)
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug',
          'title',
          'category',
          'section',
          'date',
          'readTime',
          'views',
          'image',
          'excerpt',
          'content',
          'reactions',
          'isDeleted',
          'updatedAt'
        ]);

      allow delete: if isValidId(articleId) && isAdmin();
    }

    match /infoSectionData/{docId} {
      allow get, list: if true;

      allow create: if isValidId(docId)
        && isVerifiedUser()
        && isValidInfoSectionData(incoming(), docId)
        && (isAdmin() || isOperatorSeksiForUnit(incoming().seksiUnitId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(docId)
        && isVerifiedUser()
        && isValidInfoSectionData(incoming(), docId)
        && (isAdmin() || isOperatorSeksiForUnit(existing().seksiUnitId))
        && incoming().id == existing().id
        && incoming().seksiUnitId == existing().seksiUnitId
        && incoming().infoUnitId == existing().infoUnitId
        && incoming().sectionId == existing().sectionId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'sectionLabel',
          'title',
          'subtitle',
          'updatedAtLabel',
          'columns',
          'rowsJson',
          'rowCount',
          'metricsJson',
          'orgNodesJson',
          'footnote',
          'updatedByName',
          'updatedAt'
        ]);

      allow delete: if isValidId(docId)
        && isVerifiedUser()
        && (isAdmin() || isOperatorSeksiForUnit(existing().seksiUnitId));
    }
  }
}
