      <!-- Architectural Building Facade -->
      <div class="relative bg-gradient-to-b from-white via-slate-50 to-slate-100 rounded-t-[2.5rem] rounded-b-3xl shadow-2xl border border-slate-200/90 pt-6 sm:pt-10 px-4 sm:px-10 pb-0 overflow-hidden">
        
        <!-- Top Roof Cornice & Emerald Accent -->
