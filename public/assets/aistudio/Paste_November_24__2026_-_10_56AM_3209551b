    // State Management
    let currentSection = null;
    let currentService = null;
    let savedTicket = null;
    let queueCounter = 14;
    let revealTimers = [];
    let miniRevealTimers = [];

    // Initialize Icons & Render Sections on Load
    window.addEventListener('DOMContentLoaded', () => {
      renderSectionsGrid();
      lucide.createIcons();
    });

    // Clear any running slow-motion timers
    function clearRevealTimers() {
      revealTimers.forEach(timer => clearTimeout(timer));
      revealTimers = [];
    }

    function clearMiniRevealTimers() {
      miniRevealTimers.forEach(timer => clearTimeout(timer));
      miniRevealTimers = [];
    }

    // 2. ANIMASI PINTU TERBUKA & MASUK KE RUANG LOBI PTSP (SUPER SLOW-MOTION 1 PER 1)
    function enterPTSPBuilding() {
      const doorZone = document.getElementById('door-interactive-zone');
      const buildingStage = document.getElementById('building-stage');
      const exteriorHeader = document.getElementById('exterior-header');
      const exteriorView = document.getElementById('exterior-view');
      const lobbyView = document.getElementById('lobby-view');
      const exitBtn = document.getElementById('btn-exit-building');

      // Prevent double trigger
      if (doorZone.classList.contains('doors-opened')) return;

      // Step 1: Open double doors inward (3D rotation)
      doorZone.classList.add('doors-opened');
      exteriorHeader.style.opacity = '0';
      exteriorHeader.style.transform = 'translateY(-12px)';

      // Step 2: Camera zooms in through the open doorway
      setTimeout(() => {
        buildingStage.classList.add('entering');
      }, 450);

      // Step 3: Enter PTSP Room & begin Super Slow-Motion 1-by-1 reveal
      setTimeout(() => {
        exteriorView.classList.add('hidden');
        lobbyView.classList.remove('lobby-hidden');
        lobbyView.classList.add('lobby-visible');
        
        // Show "Keluar Gedung" button in header
        exitBtn.classList.remove('hidden');
        exitBtn.classList.add('inline-flex');

        // Trigger Super Slow-Motion 1-by-1 Lobby & Honeycomb Reveal
        triggerSuperSlowMotionSequence();

        window.scrollTo({ top: 0, behavior: 'smooth' });
        lucide.createIcons();
      }, 1250);
    }

    // Super Slow-Motion 1-by-1 Orchestrator inside PTSP Room
    function triggerSuperSlowMotionSequence() {
      clearRevealTimers();

      const banner = document.getElementById('lobby-banner');
      const sectionBar = document.getElementById('lobby-section-bar');
      const honeycombFrame = document.getElementById('lobby-honeycomb-frame');
      const statusText = document.getElementById('reveal-status-text');
      const hexCells = document.querySelectorAll('.hex-wrapper');

      // Reset all lobby elements to initial hidden state
      [banner, sectionBar, honeycombFrame].forEach(el => {
        if (el) el.classList.remove('revealed');
      });

      hexCells.forEach(cell => {
        cell.classList.remove('hex-animate-in');
        void cell.offsetWidth; // Force reflow
      });

      if (statusText) {
        statusText.textContent = 'Memasuki Ruang PTSP...';
      }

      // 1. Reveal Welcome Banner slowly
      revealTimers.push(setTimeout(() => {
        if (banner) banner.classList.add('revealed');
      }, 150));

      // 2. Reveal Section Header & Honeycomb Frame
      revealTimers.push(setTimeout(() => {
        if (sectionBar) sectionBar.classList.add('revealed');
        if (honeycombFrame) honeycombFrame.classList.add('revealed');
      }, 650));

      // 3. Reveal each Hexagon Seksi 1-by-1 in Super Slow-Motion (750ms interval between each)
      hexCells.forEach((cell, idx) => {
        const delay = 1150 + idx * 750;
        revealTimers.push(setTimeout(() => {
          cell.classList.add('hex-animate-in');
          if (statusText) {
            if (idx < hexCells.length - 1) {
              statusText.textContent = `Menampilkan Seksi ${idx + 1} dari ${hexCells.length}...`;
            } else {
              statusText.textContent = '6 Loket Seksi PTSP Aktif';
            }
          }
        }, delay));
      });
    }

    function replayHoneycombAnimation() {
      triggerSuperSlowMotionSequence();
    }

    // Return to Exterior Building Front View
    function returnToEntrance() {
      clearRevealTimers();
      const doorZone = document.getElementById('door-interactive-zone');
      const buildingStage = document.getElementById('building-stage');
      const exteriorHeader = document.getElementById('exterior-header');
      const exteriorView = document.getElementById('exterior-view');
      const lobbyView = document.getElementById('lobby-view');
      const exitBtn = document.getElementById('btn-exit-building');

      // Hide lobby and reset states
      lobbyView.classList.remove('lobby-visible');
      lobbyView.classList.add('lobby-hidden');
      exitBtn.classList.add('hidden');
      exitBtn.classList.remove('inline-flex');

      // Reset exterior view
      exteriorView.classList.remove('hidden');
      backToSections();
      clearSearch();

      // Animate doors closing smoothly after returning outside
      requestAnimationFrame(() => {
        buildingStage.classList.remove('entering');
        exteriorHeader.style.opacity = '1';
        exteriorHeader.style.transform = 'translateY(0)';
        setTimeout(() => {
          doorZone.classList.remove('doors-opened');
        }, 300);
      });

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 3. RENDER KARTU PILIHAN SEKSI BERBENTUK SARANG LEBAH (HONEYCOMB) DI LOBI PTSP
    function renderSectionsGrid() {
      const grid = document.getElementById('sections-grid');

      // Split 6 sections into 2 interlocking honeycomb rows (Row 1: 3 cells, Row 2: 3 offset cells)
      const row1 = ptspSections.slice(0, 3);
      const row2 = ptspSections.slice(3, 6);

      const createHexCellHTML = (sec) => {
        const isEmerald = sec.colorClass === 'emerald';
        const isActive = currentSection && currentSection.id === sec.id;
        const iconBg = isActive
          ? 'bg-amber-400 text-emerald-950 border-amber-300'
          : isEmerald
            ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
            : 'bg-amber-50 text-amber-700 border-amber-200';
        const badgeBg = isActive
          ? 'bg-amber-400 text-emerald-950'
          : isEmerald
            ? 'bg-emerald-900 text-white'
            : 'bg-amber-600 text-white';

        return `
          <div id="hex-cell-${sec.id}"
               onclick="selectSection('${sec.id}')"
               onmouseenter="highlightNeighborCells('${sec.id}', true)"
               onmouseleave="highlightNeighborCells('${sec.id}', false)"
               role="button"
               tabindex="0"
               onkeydown="if(event.key==='Enter' || event.key===' ') selectSection('${sec.id}')"
               class="hex-wrapper group ${isActive ? 'hex-active hex-animate-in' : ''}">
            <div class="hex-border">
              <div class="hex-inner">
                <!-- Loket Pill -->
                <span class="px-3 py-0.5 rounded-full ${badgeBg} text-[10px] font-extrabold tracking-wider uppercase mb-2.5 shadow-sm">
                  ${sec.counter} • Kode ${sec.code}
                </span>

                <!-- Section Icon -->
                <div class="w-12 h-12 rounded-2xl ${iconBg} border flex items-center justify-center mb-2.5 group-hover:scale-110 transition-transform duration-300 shadow-sm">
                  <i data-lucide="${sec.icon}" class="w-6 h-6"></i>
                </div>

                <!-- Section Title -->
                <h4 class="text-sm lg:text-[15px] font-extrabold ${isActive ? 'text-white' : 'text-slate-900 group-hover:text-emerald-900'} leading-snug line-clamp-2 px-2 mb-1.5">
                  ${sec.name}
                </h4>

                <!-- Service Count & CTA -->
                <div class="mt-1 inline-flex items-center gap-1 text-[11px] font-bold ${isActive ? 'text-amber-300' : 'text-emerald-800 group-hover:text-amber-600'} transition-colors">
                  <span>${sec.services.length} Layanan</span>
                  <i data-lucide="chevron-down" class="w-3.5 h-3.5 group-hover:translate-y-0.5 transition-transform"></i>
                </div>
              </div>
            </div>
          </div>
        `;
      };

      grid.innerHTML = `
        <div class="honeycomb-row">
          ${row1.map(createHexCellHTML).join('')}
        </div>
        <div class="honeycomb-row honeycomb-row-offset">
          ${row2.map(createHexCellHTML).join('')}
        </div>
      `;
    }

    // Subtle pulse on adjacent honeycomb cells when hovering
    function highlightNeighborCells(hoveredId, isHovering) {
      document.querySelectorAll('.hex-wrapper').forEach(el => {
        if (el.id !== `hex-cell-${hoveredId}`) {
          if (isHovering) {
            el.classList.add('hex-neighbor-pulse');
          } else {
            el.classList.remove('hex-neighbor-pulse');
          }
        }
      });
    }

    // 4. PILIH SEKSI DARI SARANG LEBAH -> MUNCULKAN DROPDOWN SARANG LEBAH LEBIH KECIL UNTUK LAYANAN
    function selectSection(sectionId) {
      // Toggle close if clicking the same active section
      if (currentSection && currentSection.id === sectionId) {
        backToSections();
        return;
      }

      const section = ptspSections.find(s => s.id === sectionId);
      if (!section) return;

      currentSection = section;
      clearMiniRevealTimers();

      // Update active state on Honeycomb cells while keeping Honeycomb visible
      renderSectionsGrid();
      document.querySelectorAll('.hex-wrapper').forEach(el => el.classList.add('hex-animate-in'));

      document.getElementById('search-results-container').classList.add('hidden');
      const servicesContainer = document.getElementById('services-container');
      servicesContainer.classList.remove('hidden');

      // Populate Section Badge & Header inside Dropdown
      document.getElementById('selected-section-badge').innerHTML = `
        <i data-lucide="map-pin" class="w-3.5 h-3.5"></i>
        <span>${section.counter} • Kode Antrean ${section.code}</span>
      `;

      document.getElementById('selected-section-header').innerHTML = `
        <div class="w-11 h-11 rounded-2xl bg-emerald-900 text-amber-300 flex items-center justify-center shrink-0 shadow-md">
          <i data-lucide="${section.icon}" class="w-5 h-5"></i>
        </div>
        <div>
          <span class="text-[11px] font-bold uppercase tracking-wider text-amber-700 block">Dropdown Layanan Seksi</span>
          <h3 class="text-base sm:text-lg font-extrabold text-slate-900 leading-tight">${section.name}</h3>
        </div>
      `;

      // Build Mini-Honeycomb Cluster of Services (split into interlocking rows of max 2-3 cells)
      const servicesList = document.getElementById('services-list');
      const midPoint = Math.ceil(section.services.length / 2);
      const miniRow1 = section.services.slice(0, midPoint);
      const miniRow2 = section.services.slice(midPoint);

      const createMiniServiceHexHTML = (srv, globalIdx) => `
        <div onclick="openServiceModal('${section.id}', '${srv.id}')"
             role="button"
             tabindex="0"
             onkeydown="if(event.key==='Enter' || event.key===' ') openServiceModal('${section.id}', '${srv.id}')"
             class="mini-hex-wrapper group">
          <div class="mini-hex-border">
            <div class="mini-hex-inner">
              <span class="px-2.5 py-0.5 rounded-full bg-emerald-900 text-amber-300 text-[9px] font-extrabold tracking-wider uppercase mb-1.5 shadow-sm">
                Layanan #0${globalIdx + 1} • ${srv.time}
              </span>
              <h4 class="text-xs lg:text-[13px] font-extrabold text-slate-900 group-hover:text-emerald-950 leading-snug line-clamp-3 px-1.5 mb-2">
                ${srv.title}
              </h4>
              <div class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 group-hover:text-amber-700 transition-colors">
                <span>${srv.fee}</span>
                <span>•</span>
                <span class="underline">Pilih</span>
                <i data-lucide="arrow-right" class="w-3 h-3 group-hover:translate-x-0.5 transition-transform"></i>
              </div>
            </div>
          </div>
        </div>
      `;

      servicesList.innerHTML = `
        <div class="mini-hive-row">
          ${miniRow1.map((srv, idx) => createMiniServiceHexHTML(srv, idx)).join('')}
        </div>
        ${miniRow2.length > 0 ? `
          <div class="mini-hive-row mini-hive-row-offset">
            ${miniRow2.map((srv, idx) => createMiniServiceHexHTML(srv, midPoint + idx)).join('')}
          </div>
        ` : ''}
      `;

      lucide.createIcons();

      // Animate mini honeycomb cells 1-by-1 in smooth slow motion
      const miniCells = servicesList.querySelectorAll('.mini-hex-wrapper');
      miniCells.forEach((cell, idx) => {
        miniRevealTimers.push(setTimeout(() => {
          cell.classList.add('mini-hex-animate');
        }, 140 + idx * 240));
      });

      servicesContainer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    // Back to Section Selection
    function backToSections() {
      clearMiniRevealTimers();
      currentSection = null;
      document.getElementById('services-container').classList.add('hidden');
      renderSectionsGrid();
      document.querySelectorAll('.hex-wrapper').forEach(el => el.classList.add('hex-animate-in'));
      lucide.createIcons();
    }

    // 5. PENCARIAN CEPAT LAYANAN PTSP
    function handleSearch(query) {
      const trimmed = query.trim().toLowerCase();
      const searchContainer = document.getElementById('search-results-container');
      const searchGrid = document.getElementById('search-results-grid');
      const sectionsContainer = document.getElementById('sections-container');
      const servicesContainer = document.getElementById('services-container');

      if (!trimmed) {
        searchContainer.classList.add('hidden');
        sectionsContainer.classList.remove('hidden');
        if (currentSection) {
          servicesContainer.classList.remove('hidden');
        }
        return;
      }

      sectionsContainer.classList.add('hidden');
      servicesContainer.classList.add('hidden');
      searchContainer.classList.remove('hidden');

      const matchedServices = [];
      ptspSections.forEach(sec => {
        sec.services.forEach(srv => {
          if (
            srv.title.toLowerCase().includes(trimmed) ||
            srv.desc.toLowerCase().includes(trimmed) ||
            sec.name.toLowerCase().includes(trimmed)
          ) {
            matchedServices.push({ section: sec, service: srv });
          }
        });
      });

      if (matchedServices.length === 0) {
        searchGrid.innerHTML = `
          <div class="col-span-full bg-white rounded-3xl p-8 text-center border border-slate-200">
            <p class="text-sm font-bold text-slate-700">Layanan "${query}" tidak ditemukan.</p>
            <p class="text-xs text-slate-500 mt-1">Coba kata kunci lain seperti "Haji", "Ijazah", "Wakaf", "Nikah", atau "Pesantren".</p>
          </div>
        `;
        return;
      }

      searchGrid.innerHTML = matchedServices.map(({ section, service }) => `
        <div class="bg-white rounded-3xl p-5 border border-slate-200 hover:border-emerald-500 shadow-sm flex flex-col justify-between">
          <div>
            <span class="inline-block px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 text-[11px] font-bold mb-2">
              ${section.name} • ${section.counter}
            </span>
            <h4 class="text-base font-extrabold text-slate-900 mb-1.5">${service.title}</h4>
            <p class="text-xs text-slate-600 mb-4">${service.desc}</p>
          </div>
          <button onclick="openServiceModal('${section.id}', '${service.id}')"
                  class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-2xl bg-emerald-800 hover:bg-emerald-900 text-white text-xs font-bold transition-colors cursor-pointer">
            <span>Pilih Layanan</span>
            <i data-lucide="arrow-right" class="w-4 h-4 text-amber-300"></i>
          </button>
        </div>
      `).join('');

      lucide.createIcons();
    }

    function clearSearch() {
      document.getElementById('service-search-input').value = '';
      handleSearch('');
    }

    // 6. MODAL PERSYARATAN & PENGAJUAN LAYANAN
    function openServiceModal(sectionId, serviceId) {
      const section = ptspSections.find(s => s.id === sectionId);
      const service = section?.services.find(srv => srv.id === serviceId);
      if (!section || !service) return;

      currentSection = section;
      currentService = service;

      document.getElementById('modal-section-name').textContent = `${section.name} (${section.counter})`;
      document.getElementById('modal-service-title').textContent = service.title;
      document.getElementById('modal-service-time').textContent = service.time;
      document.getElementById('modal-service-fee').textContent = service.fee;
      document.getElementById('modal-service-counter').textContent = `${section.counter} (Kode ${section.code})`;

      // Render Requirements Checklist
      const reqList = document.getElementById('modal-requirements-list');
      reqList.innerHTML = service.requirements.map((req, index) => `
        <label class="flex items-start gap-3 p-2.5 rounded-xl bg-white border border-slate-200/80 hover:border-emerald-400 cursor-pointer transition-colors">
          <input type="checkbox" onchange="updateChecklistCount()" class="req-checkbox mt-0.5 w-4 h-4 accent-emerald-700 rounded cursor-pointer" />
          <span class="text-xs sm:text-sm text-slate-700 leading-snug">${req}</span>
        </label>
      `).join('');

      updateChecklistCount();

      const modal = document.getElementById('application-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      lucide.createIcons();
    }

    function updateChecklistCount() {
      const checkboxes = document.querySelectorAll('.req-checkbox');
      const checked = document.querySelectorAll('.req-checkbox:checked').length;
      document.getElementById('checklist-counter').textContent = `${checked}/${checkboxes.length} Berkas Siap`;
    }

    function closeApplicationModal() {
      const modal = document.getElementById('application-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    // 7. SUBMIT PERMOHONAN & TERBITKAN TIKET ANTREAN DIGITAL
    function submitPTSPApplication(event) {
      event.preventDefault();
      if (!currentSection || !currentService) return;

      const name = document.getElementById('applicant-name').value.trim();
      const phone = document.getElementById('applicant-phone').value.trim();
      const org = document.getElementById('applicant-org').value.trim();
      const method = document.getElementById('applicant-method').value;

      queueCounter += 1;
      const paddedNum = String(queueCounter).padStart(3, '0');
      const queueNumber = `${currentSection.code}-${paddedNum}`;
      const randomSuffix = Math.floor(1000 + Math.random() * 9000);
      const regCode = `REG-PTSP-MURA-2026-${randomSuffix}`;

      const now = new Date();
      const formattedDate = now.toLocaleDateString('id-ID', {
        day: '2-digit', month: 'short', year: 'numeric',
        hour: '2-digit', minute: '2-digit'
      }) + ' WIB';

      savedTicket = {
        regCode,
        queueNumber,
        counterLabel: `${currentSection.counter} • ${currentSection.name}`,
        applicantName: org ? `${name} (${org})` : name,
        phone,
        serviceName: currentService.title,
        method,
        timestamp: formattedDate
      };

      // Reset form & close application modal
      document.getElementById('ptsp-application-form').reset();
      closeApplicationModal();

      // Enable "Tiket Saya" button in top navbar
      const myTicketBtn = document.getElementById('btn-my-ticket');
      myTicketBtn.classList.remove('hidden');
      myTicketBtn.classList.add('inline-flex');

      // Show Ticket Modal
      renderAndOpenTicketModal(savedTicket);
    }

    function renderAndOpenTicketModal(ticket) {
      document.getElementById('ticket-reg-code').textContent = ticket.regCode;
      document.getElementById('ticket-queue-number').textContent = ticket.queueNumber;
      document.getElementById('ticket-counter-label').textContent = ticket.counterLabel;
      document.getElementById('ticket-applicant-name').textContent = ticket.applicantName;
      document.getElementById('ticket-service-name').textContent = ticket.serviceName;
      document.getElementById('ticket-method').textContent = ticket.method;
      document.getElementById('ticket-timestamp').textContent = ticket.timestamp;

      document.getElementById('copy-toast').classList.add('hidden');
      const modal = document.getElementById('ticket-modal');
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      lucide.createIcons();
    }

    function openSavedTicket() {
      if (savedTicket) {
        renderAndOpenTicketModal(savedTicket);
      }
    }

    function closeTicketModal() {
      const modal = document.getElementById('ticket-modal');
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    function copyTicketCode() {
      if (!savedTicket) return;
      const textToCopy = `${savedTicket.regCode} | Antrean: ${savedTicket.queueNumber} (${savedTicket.serviceName})`;
      
      const tempInput = document.createElement('textarea');
      tempInput.value = textToCopy;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand('copy');
      document.body.removeChild(tempInput);

      const toast = document.getElementById('copy-toast');
      toast.classList.remove('hidden');
      setTimeout(() => toast.classList.add('hidden'), 2800);
    }

