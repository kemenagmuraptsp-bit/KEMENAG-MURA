          </div>
          <span class="text-[10px] sm:text-xs font-bold tracking-[0.18em] text-amber-300 uppercase text-center">
            Kantor Kementerian Agama Kabupaten Murung Raya
          </span>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
          </div>
        </div>

        <!-- Main Portico / Canopy Signboard -->
        <div class="max-w-xl mx-auto mb-5 sm:mb-7 relative z-10">
          <div class="bg-gradient-to-r from-emerald-900 via-emerald-800 to-emerald-900 rounded-2xl p-3.5 sm:p-5 text-center shadow-xl border-2 border-amber-400/70 relative">
            <!-- Downlights under signboard -->
            <div class="absolute -bottom-2 left-1/4 w-8 h-1.5 bg-amber-200 rounded-full blur-[2px] opacity-90"></div>
