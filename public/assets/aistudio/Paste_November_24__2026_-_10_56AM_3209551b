        <button id="btn-my-ticket" onclick="openSavedTicket()" class="hidden items-center gap-2 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-white text-xs sm:text-sm font-bold transition-all shadow-md shadow-amber-500/20">
