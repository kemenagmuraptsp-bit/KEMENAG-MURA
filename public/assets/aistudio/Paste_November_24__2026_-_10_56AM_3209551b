<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PTSP Kemenag Kabupaten Murung Raya — Pelayanan Terpadu Satu Pintu</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'Inter', 'sans-serif'],
            body: ['Inter', 'sans-serif'],
          },
          colors: {
            kemenag: {
              dark: '#022c22',
              primary: '#065F46',
              medium: '#047857',
              light: '#10B981',
              soft: '#ECFDF5',
              gold: '#D97706',
              goldLight: '#F59E0B',
              goldSoft: '#FEF3C7',
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Custom Architectural & 3D Door Perspective Styles */
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
      background-color: #f8fafc;
    }

    /* Islamic Geometric Subtle Pattern */
    .islamic-pattern {
      background-image: radial-gradient(rgba(217, 119, 6, 0.14) 1px, transparent 1px),
                        radial-gradient(rgba(6, 95, 70, 0.12) 1px, #f8fafc 1px);
      background-size: 36px 36px;
      background-position: 0 0, 18px 18px;
    }

    .islamic-pattern-dark {
      background-image: linear-gradient(30deg, rgba(255,255,255,0.03) 12%, transparent 12.5%, transparent 87%, rgba(255,255,255,0.03) 87.5%, rgba(255,255,255,0.03)),
                        linear-gradient(150deg, rgba(255,255,255,0.03) 12%, transparent 12.5%, transparent 87%, rgba(255,255,255,0.03) 87.5%, rgba(255,255,255,0.03)),
                        linear-gradient(30deg, rgba(255,255,255,0.03) 12%, transparent 12.5%, transparent 87%, rgba(255,255,255,0.03) 87.5%, rgba(255,255,255,0.03)),
                        linear-gradient(150deg, rgba(255,255,255,0.03) 12%, transparent 12.5%, transparent 87%, rgba(255,255,255,0.03) 87.5%, rgba(255,255,255,0.03));
      background-size: 48px 84px;
      background-position: 0 0, 0 0, 24px 42px, 24px 42px;
    }

    /* 3D Door Scene */
    .building-stage {
      perspective: 1400px;
      transform-style: preserve-3d;
      transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1), opacity 1.1s ease-in-out;
    }

    /* Zoom-in camera effect when entering */
    .building-stage.entering {
      transform: scale(2.85) translateY(8%);
      opacity: 0;
      pointer-events: none;
    }

    .door-frame {
      perspective: 1200px;
      transform-style: preserve-3d;
    }

    .door-leaf-left {
      transform-origin: left center;
      transition: transform 0.95s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease;
      transform-style: preserve-3d;
    }

    .door-leaf-right {
      transform-origin: right center;
      transition: transform 0.95s cubic-bezier(0.25, 1, 0.5, 1), box-shadow 0.4s ease;
      transform-style: preserve-3d;
    }

    /* Subtle hover ajar preview */
    .door-interactive-zone:hover .door-leaf-left {
      transform: rotateY(14deg);
    }
    .door-interactive-zone:hover .door-leaf-right {
      transform: rotateY(-14deg);
    }

    /* Full open inward on click */
    .door-interactive-zone.doors-opened .door-leaf-left {
      transform: rotateY(105deg) !important;
    }
    .door-interactive-zone.doors-opened .door-leaf-right {
      transform: rotateY(-105deg) !important;
    }

    /* Warm light glow inside doorway */
    .interior-glow {
      background: radial-gradient(circle at 50% 45%, #ffffff 0%, #fef3c7 35%, #d1fae5 75%, #065f46 100%);
      transition: opacity 0.6s ease, filter 0.6s ease;
    }

    .door-interactive-zone:hover .interior-glow {
      filter: brightness(1.12);
    }

    /* Floating animation for tooltip */
    @keyframes floatBadge {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-6px); }
    }
    .animate-float {
      animation: floatBadge 2.6s ease-in-out infinite;
    }

    /* Smooth Lobby Entrance */
    .lobby-view {
      transition: opacity 1.1s ease, transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .lobby-hidden {
      opacity: 0;
      transform: scale(0.96);
      pointer-events: none;
      display: none;
    }
    .lobby-visible {
      opacity: 1;
      transform: scale(1);
      display: block;
    }

    /* Super Slow-Motion Lobby Interior Elements Reveal */
    .lobby-slow-element {
      opacity: 0;
      transform: translateY(28px) scale(0.97);
      filter: blur(6px);
      transition: opacity 1.4s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 1.5s cubic-bezier(0.16, 1, 0.3, 1),
                  filter 1.2s ease-out;
    }
    .lobby-slow-element.revealed {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0px);
    }

    /* =====================================================================
       HONEYCOMB (SARANG LEBAH) SUPER SLOW-MOTION & INTERACTIVE HEXAGON STYLES
       ===================================================================== */
    .honeycomb-stage {
      position: relative;
      perspective: 1400px;
      background: radial-gradient(circle at 50% 0%, rgba(236, 253, 245, 0.95) 0%, rgba(255, 255, 255, 0.85) 60%, rgba(254, 243, 199, 0.45) 100%);
    }

    /* Responsive Honeycomb Cluster Layout (Desktop Interlocking 3-3 Hive) */
    .honeycomb-hive {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .honeycomb-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }

    @media (min-width: 768px) {
      .honeycomb-hive {
        gap: 0;
        padding: 1rem 0 2rem 0;
      }
      .honeycomb-row {
        flex-wrap: nowrap;
        gap: 1.25rem;
      }
      /* Interlock second row into the recesses of the first row */
      .honeycomb-row-offset {
        margin-top: -3.2rem;
      }
    }

    @media (min-width: 1024px) {
      .honeycomb-row {
        gap: 1.5rem;
      }
      .honeycomb-row-offset {
        margin-top: -3.65rem;
      }
    }

    /* Hexagon Outer Golden Border Wrapper */
    .hex-wrapper {
      width: 245px;
      height: 276px;
      position: relative;
      opacity: 0;
      transform: scale(0.55) translateY(48px) rotateX(24deg);
      filter: blur(8px) drop-shadow(0 12px 20px rgba(2, 44, 34, 0.10));
      transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), filter 0.55s ease;
      cursor: pointer;
    }

    @media (min-width: 1024px) {
      .hex-wrapper {
        width: 272px;
        height: 306px;
      }
    }

    /* Super Slow-Motion 1-by-1 Honeycomb Entrance Animation (2.4s per cell) */
    @keyframes honeycombSuperSlowReveal {
      0% {
        opacity: 0;
        transform: scale(0.55) translateY(52px) rotateX(24deg);
        filter: blur(10px) drop-shadow(0 0 0 rgba(217, 119, 6, 0));
      }
      45% {
        opacity: 0.78;
        filter: blur(2px) drop-shadow(0 18px 34px rgba(245, 158, 11, 0.35));
      }
      75% {
        opacity: 1;
        transform: scale(1.03) translateY(-5px) rotateX(0deg);
        filter: blur(0px) drop-shadow(0 16px 28px rgba(16, 185, 129, 0.22));
      }
      100% {
        opacity: 1;
        transform: scale(1) translateY(0px) rotateX(0deg);
        filter: blur(0px) drop-shadow(0 12px 20px rgba(2, 44, 34, 0.10));
      }
    }

    .hex-wrapper.hex-animate-in {
      animation: honeycombSuperSlowReveal 2.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Hover & Active Glow States */
    .hex-wrapper:hover {
      transform: translateY(-8px) scale(1.04) !important;
      filter: drop-shadow(0 20px 32px rgba(217, 119, 6, 0.32)) !important;
      z-index: 20;
    }

    .hex-wrapper.hex-active {
      transform: translateY(-6px) scale(1.05) !important;
      filter: drop-shadow(0 22px 34px rgba(6, 95, 70, 0.35)) !important;
      z-index: 25;
    }

    /* Subtle pulse on neighbor cells when hovering another cell */
    .hex-wrapper.hex-neighbor-pulse .hex-border {
      background: linear-gradient(135deg, #f59e0b 0%, #10b981 50%, #f59e0b 100%);
    }

    /* True Pointy-Top Hexagon Clip Path */
    .hex-border {
      width: 100%;
      height: 100%;
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      background: linear-gradient(145deg, rgba(217, 119, 6, 0.55), rgba(6, 95, 70, 0.45), rgba(245, 158, 11, 0.7));
      padding: 3px;
      transition: background 0.4s ease;
    }

    .hex-wrapper:hover .hex-border,
    .hex-wrapper.hex-active .hex-border {
      background: linear-gradient(135deg, #fbbf24 0%, #d97706 45%, #059669 100%);
      padding: 4px;
    }

    .hex-inner {
      width: 100%;
      height: 100%;
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 70%, #ecfdf5 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2.1rem 1.35rem;
      position: relative;
      transition: background 0.4s ease;
    }

    .hex-wrapper.hex-active .hex-inner {
      background: linear-gradient(180deg, #064e3b 0%, #065f46 65%, #022c22 100%);
      color: #ffffff;
    }

    /* Ambient Golden Particle Floating inside Honeycomb Stage */
    @keyframes goldenDustFloat {
      0%, 100% { transform: translateY(0px) scale(1); opacity: 0.35; }
      50% { transform: translateY(-14px) scale(1.25); opacity: 0.85; }
    }
    .hive-particle {
      animation: goldenDustFloat 4.5s ease-in-out infinite;
    }

    /* =====================================================================
       MINI HONEYCOMB DROPDOWN (PILIHAN LAYANAN DALAM BENTUK SARANG LEBAH KECIL)
       ===================================================================== */
    .mini-honeycomb-dropdown {
      background: radial-gradient(circle at 50% 0%, rgba(254, 243, 199, 0.55) 0%, rgba(236, 253, 245, 0.9) 55%, rgba(255, 255, 255, 0.96) 100%);
      transform-origin: top center;
      animation: dropdownHiveUnfold 0.75s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes dropdownHiveUnfold {
      0% {
        opacity: 0;
        transform: translateY(-18px) scaleY(0.92);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scaleY(1);
      }
    }

    .mini-hive-cluster {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.85rem;
    }

    .mini-hive-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.85rem;
    }

    @media (min-width: 768px) {
      .mini-hive-cluster {
        gap: 0;
        padding: 0.5rem 0 1.25rem 0;
      }
      .mini-hive-row {
        flex-wrap: nowrap;
        gap: 1rem;
      }
      .mini-hive-row-offset {
        margin-top: -2.45rem;
      }
    }

    .mini-hex-wrapper {
      width: 210px;
      height: 236px;
      position: relative;
      opacity: 0;
      transform: scale(0.6) translateY(24px);
      filter: drop-shadow(0 8px 16px rgba(2, 44, 34, 0.08));
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
      cursor: pointer;
    }

    @media (min-width: 1024px) {
      .mini-hex-wrapper {
        width: 224px;
        height: 252px;
      }
    }

    @keyframes miniHexSlowPop {
      0% {
        opacity: 0;
        transform: scale(0.6) translateY(28px);
        filter: blur(4px) drop-shadow(0 0 0 rgba(217, 119, 6, 0));
      }
      65% {
        opacity: 1;
        transform: scale(1.03) translateY(-3px);
        filter: blur(0px) drop-shadow(0 12px 22px rgba(217, 119, 6, 0.22));
      }
      100% {
        opacity: 1;
        transform: scale(1) translateY(0);
        filter: blur(0px) drop-shadow(0 8px 16px rgba(2, 44, 34, 0.08));
      }
    }

    .mini-hex-animate {
      animation: miniHexSlowPop 1.05s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .mini-hex-wrapper:hover {
      transform: translateY(-6px) scale(1.05) !important;
      filter: drop-shadow(0 16px 26px rgba(217, 119, 6, 0.28)) !important;
      z-index: 20;
    }

    .mini-hex-border {
      width: 100%;
      height: 100%;
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      background: linear-gradient(145deg, rgba(16, 185, 129, 0.55), rgba(217, 119, 6, 0.55));
      padding: 2.5px;
      transition: background 0.35s ease;
    }

    .mini-hex-wrapper:hover .mini-hex-border {
      background: linear-gradient(135deg, #fbbf24 0%, #d97706 50%, #059669 100%);
      padding: 3.5px;
    }

    .mini-hex-inner {
      width: 100%;
      height: 100%;
      clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
      background: linear-gradient(180deg, #ffffff 0%, #f8fafc 75%, #ecfdf5 100%);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 1.65rem 1.05rem;
      position: relative;
      transition: background 0.35s ease;
    }

    .mini-hex-wrapper:hover .mini-hex-inner {
      background: linear-gradient(180deg, #ffffff 0%, #fef3c7 100%);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen flex flex-col islamic-pattern selection:bg-emerald-700 selection:text-white">

  <!-- TOP NAVIGATION BAR (Always Accessible) -->
  <header class="sticky top-0 z-40 bg-white/85 backdrop-blur-md border-b border-emerald-900/10 shadow-sm">
