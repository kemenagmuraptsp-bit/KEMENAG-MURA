        <!-- Islamic Geometric Relief Header Band -->
        <div class="w-full h-10 sm:h-12 rounded-2xl bg-emerald-950 islamic-pattern-dark border border-amber-500/40 flex items-center justify-between px-4 sm:px-6 mb-5 sm:mb-7 shadow-inner">
